// No tracked migrations directory exists — schema changes are applied via
// `prisma db push`. Deploy/CI scripts that run it with `--accept-data-loss`
// apply destructive changes (dropped columns, etc.) with no further prompt —
// read the diff before running it against a real database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// MULTI-TENANCY
// ============================================================

model Organization {
  id              String   @id @default(cuid())
  name            String
  code            String   @unique
  logoUrl         String?
  address         String?
  phone           String?
  email           String?
  uen             String?  // Singapore UEN
  gstNo           String?
  isActive        Boolean  @default(true)
  defaultCurrency String   @default("SGD")
  locale          String   @default("en-SG")
  timezone        String   @default("Asia/Singapore")
  industryVertical String? // preset key applied at onboarding, e.g. "manpower-staffing"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users                   User[]
  roles                   Role[]
  userRoleAssignments     UserRoleAssignment[]
  vendorPortalUsers       VendorPortalUser[]
  clientPortalUsers       ClientPortalUser[]
  ssoConfig               OrganizationSsoConfig?
  customFieldDefinitions  CustomFieldDefinition[]
  customFieldValues       CustomFieldValue[]
  approvalChains          ApprovalChain[]
  webhookSubscriptions    WebhookSubscription[]

  employees               Employee[]
  employeeCertifications  EmployeeCertification[]
  attendances             Attendance[]
  payrollRecords          PayrollRecord[]
  leavePolicies           LeavePolicy[]
  leaveBalances           LeaveBalance[]
  leaveRequests           LeaveRequest[]
  clients                 Client[]
  projects                Project[]
  projectEmployees        ProjectEmployee[]
  expenses                Expense[]
  suppliers               Supplier[]
  equipmentCategories     EquipmentCategory[]
  equipmentItems          EquipmentItem[]
  equipmentPurchases      EquipmentPurchase[]
  equipmentIssues         EquipmentIssue[]
  warehouses              Warehouse[]
  warehouseStocks         WarehouseStock[]
  assetUnits              AssetUnit[]
  maintenanceRecords      MaintenanceRecord[]
  depreciationEntries     DepreciationEntry[]
  quotations              Quotation[]
  quotationLineItems      QuotationLineItem[]
  invoices                Invoice[]
  invoiceLineItems        InvoiceLineItem[]
  payments                Payment[]
  workPasses              WorkPass[]
  workPassRenewals        WorkPassRenewal[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  auditLogs               AuditLog[]
  holidays                Holiday[]

  statutorySchemes        StatutoryScheme[]
  jobRequisitions         JobRequisition[]
  candidates              Candidate[]
  applications            Application[]
  checklistTemplates      ChecklistTemplate[]
  checklistInstances      ChecklistInstance[]
  skillDefinitions        SkillDefinition[]
  employeeSkills          EmployeeSkill[]
  performanceReviewCycles PerformanceReviewCycle[]
  performanceReviews      PerformanceReview[]
  employeeCases           EmployeeCase[]
  payrollRuns             PayrollRun[]

  @@map("organizations")
}

// ============================================================
// AUTH & USERS (Employer + Employee personas — both are `User`
// rows today; persona is derived from `role` at token-sign time:
// EMPLOYEE -> "EMPLOYEE" persona, everything else -> "EMPLOYER".
// Vendor/Client personas use their own identity tables below.)
// ============================================================

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  passwordHash   String
  role           UserRole      @default(EMPLOYEE)
  isActive       Boolean       @default(true)
  lastLoginAt    DateTime?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  employee            Employee?
  notifications       Notification[]
  auditLogs           AuditLog[]
  passwordResetTokens PasswordResetToken[]
  refreshTokens        RefreshToken[]
  roleAssignments      UserRoleAssignment[]
  approvalActions      ApprovalAction[]
  approvalStepsAsApprover ApprovalStep[]
  employeeCaseComments EmployeeCaseComment[]

  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  SUPERVISOR
  EMPLOYEE
}

// ============================================================
// RBAC — replaces flat UserRole-only gating. UserRole/User.role
// stays as a legacy default-role display field; access control
// flows through Role -> RolePermission -> Permission from here on.
// ============================================================

model Role {
  id             String   @id @default(cuid())
  organizationId String?  // null = system-defined role template, shared across all tenants
  organization   Organization? @relation(fields: [organizationId], references: [id])
  key            String   // e.g. "ADMIN", or a tenant-custom key
  name           String
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  rolePermissions RolePermission[]
  userAssignments UserRoleAssignment[]
  approvalSteps   ApprovalStep[]
  checklistTemplateTasks ChecklistTemplateTask[]

  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId         String
  role           Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  scopeType      String?  // e.g. "DEPARTMENT", "BRANCH" — null = org-wide
  scopeId        String?
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([organizationId])
  @@map("user_role_assignments")
}

// ============================================================
// AUTH FOUNDATIONS — refresh tokens (Employer/Employee persona,
// both `User`-backed) + minimal Vendor/Client portal identities
// (full vendor/client business modules land in Phase 4/5; this
// pass only gives the 4-persona auth model something to
// authenticate against) + per-org SSO configuration (scaffold,
// disabled until an org admin supplies real IdP credentials).
// ============================================================

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model VendorPortalUser {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  supplierId     String?
  supplier       Supplier? @relation(fields: [supplierId], references: [id])
  email          String
  passwordHash   String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, email])
  @@map("vendor_portal_users")
}

model ClientPortalUser {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id])
  email          String
  passwordHash   String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, email])
  @@map("client_portal_users")
}

model OrganizationSsoConfig {
  id                    String      @id @default(cuid())
  organizationId        String      @unique
  organization          Organization @relation(fields: [organizationId], references: [id])
  provider              SsoProvider @default(OIDC)
  issuerUrl             String?
  clientId              String?
  clientSecretEncrypted String?
  enabled               Boolean     @default(false)
  createdAt             DateTime    @default(now())
  updatedAt              DateTime   @updatedAt

  @@map("organization_sso_configs")
}

enum SsoProvider {
  OIDC
  SAML
}

// ============================================================
// PLATFORM CUSTOMIZATION — generic custom fields, usable by any
// future entity type without schema changes.
// ============================================================

model CustomFieldDefinition {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  entityType     String        // e.g. "Employee", "Project" — free-form, extensible on purpose
  fieldKey       String
  label          String
  fieldType      CustomFieldType
  options        Json?
  required       Boolean       @default(false)
  sortOrder      Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  values         CustomFieldValue[]

  @@unique([organizationId, entityType, fieldKey])
  @@map("custom_field_definitions")
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
  MULTI_SELECT
}

model CustomFieldValue {
  id               String   @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  entityType       String
  entityId         String
  fieldDefinitionId String
  fieldDefinition  CustomFieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)
  value            Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([entityType, entityId, fieldDefinitionId])
  @@index([organizationId, entityType, entityId])
  @@map("custom_field_values")
}

// ============================================================
// APPROVAL CHAIN ENGINE — generic, reusable by Leave/Expense/PO/
// Payroll flows. Not wired into existing approval fields yet
// (Phase 1/4 follow-up); schema + service exist so those flows
// can migrate onto it without another schema change later.
// ============================================================

model ApprovalChain {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  entityType     String
  name           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  steps     ApprovalStep[]
  instances ApprovalInstance[]

  @@index([organizationId, entityType])
  @@map("approval_chains")
}

model ApprovalStep {
  id             String  @id @default(cuid())
  chainId        String
  chain          ApprovalChain @relation(fields: [chainId], references: [id], onDelete: Cascade)
  stepOrder      Int
  approverRoleId String?
  approverRole   Role?   @relation(fields: [approverRoleId], references: [id])
  approverUserId String?
  approverUser   User?   @relation(fields: [approverUserId], references: [id])
  required       Boolean @default(true)

  actions ApprovalAction[]

  @@unique([chainId, stepOrder])
  @@map("approval_steps")
}

model ApprovalInstance {
  id               String   @id @default(cuid())
  chainId          String
  chain            ApprovalChain @relation(fields: [chainId], references: [id])
  entityType       String
  entityId         String
  status           ApprovalInstanceStatus @default(PENDING)
  currentStepOrder Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  actions ApprovalAction[]
  leaveRequest LeaveRequest?

  @@index([entityType, entityId])
  @@map("approval_instances")
}

enum ApprovalInstanceStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model ApprovalAction {
  id          String   @id @default(cuid())
  instanceId  String
  instance    ApprovalInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stepId      String
  step        ApprovalStep @relation(fields: [stepId], references: [id])
  actorUserId String
  actorUser   User     @relation(fields: [actorUserId], references: [id])
  decision    ApprovalDecision
  comment     String?
  actedAt     DateTime @default(now())

  @@map("approval_actions")
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

// ============================================================
// INTEGRATIONS — public API webhook subscriptions & delivery log.
// Fire-and-forget dispatch this pass (no queue — that's Phase 7).
// ============================================================

model WebhookSubscription {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  url            String
  eventTypes     String[]
  secret         String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@index([organizationId])
  @@map("webhook_subscriptions")
}

model WebhookDelivery {
  id             String   @id @default(cuid())
  subscriptionId String
  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  eventType      String
  payload        Json
  statusCode     Int?
  attemptedAt    DateTime @default(now())
  success        Boolean  @default(false)

  @@index([subscriptionId])
  @@map("webhook_deliveries")
}

// ============================================================
// MODULE 1: EMPLOYEE & PAYROLL
// ============================================================

model Employee {
  id               String         @id @default(cuid())
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id])
  employeeCode     String
  userId           String?        @unique
  user             User?          @relation(fields: [userId], references: [id])
  firstName        String
  lastName         String
  email            String?
  phone            String?
  nationality      String?
  identityDocType  String?        // country-agnostic: "NRIC_FIN","PASSPORT","SSN","AADHAAR",... (no DocumentType catalog until Phase 2)
  identityDocNumber String?       // encrypted at rest, same mechanism as the legacy nricOrFin
  dateOfBirth      DateTime?
  employmentType   EmploymentType @default(FULL_TIME)
  jobTitle         String?
  department       String?
  skills           String[]       // deprecated flat list — write-only, never rendered; EmployeeSkill is the real skill matrix going forward
  dailyRate        Decimal        @db.Decimal(10, 2)
  hourlyRate       Decimal?       @db.Decimal(10, 2)
  overtimeRate     Decimal?       @db.Decimal(10, 2)
  allowances       Decimal        @default(0) @db.Decimal(10, 2)
  statutorySchemeId String?
  statutoryScheme  StatutoryScheme? @relation(fields: [statutorySchemeId], references: [id])
  bankName         String?
  bankAccountNo    String?
  joinDate         DateTime
  resignDate       DateTime?
  isActive         Boolean        @default(true)
  emergencyContact String?
  address          String?
  photoUrl         String?
  managerId        String?
  manager          Employee?      @relation("EmployeeManager", fields: [managerId], references: [id])
  directReports    Employee[]     @relation("EmployeeManager")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  workPass         WorkPass[]
  attendances      Attendance[]
  projectAssignments ProjectEmployee[]
  expenseSubmissions Expense[]
  equipmentIssues  EquipmentIssue[]
  assetUnits       AssetUnit[]
  certifications   EmployeeCertification[]
  leaveRequests    LeaveRequest[]
  leaveBalances    LeaveBalance[]
  approvedLeaves   LeaveRequest[] @relation("LeaveApprover")

  jobRequisitionsRequested JobRequisition[] @relation("RequisitionRequester")
  applicationHire  Application? @relation("ApplicationHire")
  checklistInstances ChecklistInstance[]
  employeeSkills   EmployeeSkill[]
  performanceReviews PerformanceReview[]
  performanceReviewsAsReviewer PerformanceReview[] @relation("PerformanceReviewer")
  employeeCases    EmployeeCase[]
  employeeCasesAssigned EmployeeCase[] @relation("CaseAssignee")

  @@unique([organizationId, employeeCode])
  @@unique([organizationId, email])
  @@unique([organizationId, identityDocNumber])
  @@index([organizationId])
  @@index([managerId])
  @@map("employees")
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  FOREIGN_WORKER
}

model EmployeeCertification {
  id             String    @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id])
  name         String
  issuedBy     String?
  issuedDate   DateTime?
  expiryDate   DateTime?
  documentUrl  String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([organizationId])
  @@map("employee_certifications")
}

model Attendance {
  id           String           @id @default(cuid())
  organizationId String
  organization Organization     @relation(fields: [organizationId], references: [id])
  employeeId   String
  employee     Employee         @relation(fields: [employeeId], references: [id])
  projectId    String?
  project      Project?         @relation(fields: [projectId], references: [id])
  date         DateTime         @db.Date
  status       AttendanceStatus @default(PRESENT)
  hoursWorked  Decimal?         @db.Decimal(5, 2)
  overtimeHours Decimal?        @db.Decimal(5, 2)
  dailyWage    Decimal          @default(0) @db.Decimal(10, 2)
  overtimePay  Decimal          @default(0) @db.Decimal(10, 2)
  notes        String?
  approvalStatus TimesheetApprovalStatus @default(PENDING)
  approvedById String?
  approvedAt   DateTime?
  rejectionReason String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([employeeId, date, projectId])
  @@index([organizationId])
  @@map("attendances")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  OVERTIME
  LEAVE
}

enum TimesheetApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model PayrollRecord {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id])
  employeeId     String
  month          Int
  year           Int
  currencyCode   String   @default("SGD")
  daysWorked     Int      @default(0)
  overtimeDays   Decimal  @default(0) @db.Decimal(5, 2)
  paidLeaveDays  Decimal  @default(0) @db.Decimal(5, 2)
  unpaidLeaveDays Decimal @default(0) @db.Decimal(5, 2)
  leaveDeduction Decimal  @default(0) @db.Decimal(10, 2)
  basicPay       Decimal  @default(0) @db.Decimal(10, 2)
  overtimePay    Decimal  @default(0) @db.Decimal(10, 2)
  allowances     Decimal  @default(0) @db.Decimal(10, 2)
  cpfEmployee    Decimal  @default(0) @db.Decimal(10, 2)
  cpfEmployer    Decimal  @default(0) @db.Decimal(10, 2)
  totalPayable   Decimal  @default(0) @db.Decimal(10, 2)
  totalCostToCompany Decimal @default(0) @db.Decimal(10, 2)
  isPaid         Boolean  @default(false)
  paidAt         DateTime?
  payrollRunId   String?
  payrollRun     PayrollRun? @relation(fields: [payrollRunId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([projectId, employeeId, month, year])
  @@index([organizationId])
  @@map("payroll_records")
}

// ============================================================
// MODULE 1b: LEAVE MANAGEMENT
// ============================================================

model LeavePolicy {
  id              String    @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  name            String
  leaveType       LeaveType
  daysPerYear     Int
  carryForwardMax Int       @default(0)
  isPaidLeave     Boolean   @default(true)
  applicableTo    String?   // e.g. "ALL", "SG_CITIZEN", "PR", "FOREIGNER"
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([organizationId, leaveType])
  @@map("leave_policies")
}

model LeaveBalance {
  id          String    @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  year        Int
  leaveType   LeaveType
  entitled    Int       @default(0)
  used        Int       @default(0)
  pending     Int       @default(0)
  carriedOver Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([employeeId, year, leaveType])
  @@index([organizationId])
  @@map("leave_balances")
}

model LeaveRequest {
  id               String      @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  leaveCode        String
  employeeId       String
  employee         Employee    @relation(fields: [employeeId], references: [id])
  leaveType        LeaveType
  startDate        DateTime    @db.Date
  endDate          DateTime    @db.Date
  totalDays        Int
  halfDay          Boolean     @default(false)
  reason           String?
  status           LeaveStatus @default(PENDING)
  approverId       String?
  approver         Employee?   @relation("LeaveApprover", fields: [approverId], references: [id])
  approvedAt       DateTime?
  rejectedAt       DateTime?
  rejectionReason  String?
  cancelledAt      DateTime?
  attachmentUrl    String?
  approvalInstanceId String?   @unique
  approvalInstance ApprovalInstance? @relation(fields: [approvalInstanceId], references: [id])
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([organizationId, leaveCode])
  @@map("leave_requests")
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  MATERNITY
  PATERNITY
  EMERGENCY
  COMPASSIONATE
  PUBLIC_HOLIDAY
  OFF_IN_LIEU
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  WITHDRAWN
}

// ============================================================
// MODULE 2: PROJECT MANAGEMENT & COSTING
// ============================================================

model Client {
  id           String    @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  code         String
  name         String
  contactName  String?
  contactEmail String?
  contactPhone String?
  address      String?
  uen          String?
  gstRegistered Boolean  @default(false)
  creditTermDays Int     @default(30)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  projects     Project[]
  quotations   Quotation[]
  invoices     Invoice[]
  portalUsers  ClientPortalUser[]

  @@unique([organizationId, code])
  @@map("clients")
}

model Project {
  id               String        @id @default(cuid())
  organizationId   String
  organization     Organization  @relation(fields: [organizationId], references: [id])
  projectCode      String
  name             String
  description      String?
  clientId         String
  client           Client        @relation(fields: [clientId], references: [id])
  managerId        String?
  location         String?
  startDate        DateTime
  endDate          DateTime?
  actualEndDate    DateTime?
  quotedBudget     Decimal       @default(0) @db.Decimal(12, 2)
  targetMargin     Decimal       @default(0.15) @db.Decimal(5, 4)
  overheadPercent  Decimal       @default(0) @db.Decimal(5, 4)
  status           ProjectStatus @default(DRAFT)
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  quotation        Quotation?
  employees        ProjectEmployee[]
  expenses         Expense[]
  equipmentIssues  EquipmentIssue[]
  assetUnits       AssetUnit[]
  invoices         Invoice[]
  attendances      Attendance[]
  payrollRecords   PayrollRecord[]
  notifications    Notification[]
  payrollRuns      PayrollRun[]

  @@unique([organizationId, projectCode])
  @@map("projects")
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model ProjectEmployee {
  id          String    @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id])
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  role        String?
  dailyRate   Decimal   @db.Decimal(10, 2)
  assignedAt  DateTime  @default(now())
  removedAt   DateTime?
  isActive    Boolean   @default(true)

  @@unique([projectId, employeeId])
  @@index([organizationId])
  @@map("project_employees")
}

// ============================================================
// MODULE 3: EXPENSE TRACKING
// ============================================================

model Expense {
  id           String          @id @default(cuid())
  organizationId String
  organization Organization    @relation(fields: [organizationId], references: [id])
  expenseCode  String
  projectId    String
  project      Project         @relation(fields: [projectId], references: [id])
  submittedById String
  submittedBy  Employee        @relation(fields: [submittedById], references: [id])
  category     ExpenseCategory
  amount       Decimal         @db.Decimal(10, 2)
  description  String
  date         DateTime        @db.Date
  receiptUrl   String?
  status       ExpenseStatus   @default(PENDING)
  approvedById String?
  approvedAt   DateTime?
  rejectionReason String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([organizationId, expenseCode])
  @@map("expenses")
}

enum ExpenseCategory {
  TRANSPORT
  MEALS
  MATERIALS
  SUB_CONTRACTOR
  PERMITS
  ACCOMMODATION
  MISCELLANEOUS
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================================
// MODULE 4: EQUIPMENT & INVENTORY
// ============================================================

model Supplier {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  supplierCode   String
  name           String
  contactPerson  String?
  email          String?
  phone          String?
  address        String?
  city           String?
  country        String?
  taxId          String?
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  equipmentItems EquipmentItem[]
  equipmentPurchases EquipmentPurchase[]
  maintenanceRecords MaintenanceRecord[]
  portalUsers    VendorPortalUser[]

  @@unique([organizationId, supplierCode])
  @@map("suppliers")
}

model EquipmentCategory {
  id          String      @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  name        String
  description String?
  createdAt   DateTime    @default(now())

  items       EquipmentItem[]

  @@unique([organizationId, name])
  @@map("equipment_categories")
}

model EquipmentItem {
  id                String            @id @default(cuid())
  organizationId    String
  organization      Organization      @relation(fields: [organizationId], references: [id])
  itemCode          String
  name              String
  description       String?
  categoryId        String
  category          EquipmentCategory @relation(fields: [categoryId], references: [id])
  unit              String            @default("unit")
  unitCost          Decimal           @db.Decimal(10, 2)
  currencyCode      String            @default("SGD")
  trackingMode      EquipmentTrackingMode @default(BULK)
  minStockLevel     Int               @default(5)
  reorderQty        Int?
  depreciationRate  Decimal           @default(0) @db.Decimal(5, 4)
  usefulLifeDays    Int?
  supplierName      String?
  supplierContact   String?
  supplierId        String?
  supplier          Supplier?         @relation(fields: [supplierId], references: [id])
  isActive          Boolean           @default(true)
  // Bulk (SKU-level) maintenance reminder. Serialized items use
  // AssetUnit.nextMaintenanceAt instead — per-unit, not per-SKU.
  nextMaintenanceAt DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  purchases        EquipmentPurchase[]
  issues           EquipmentIssue[]
  warehouseStocks  WarehouseStock[]
  assetUnits       AssetUnit[]
  maintenanceRecords MaintenanceRecord[]

  @@unique([organizationId, itemCode])
  @@map("equipment_items")
}

enum EquipmentTrackingMode {
  BULK
  SERIALIZED
}

model Warehouse {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  code           String
  name           String
  address        String?
  isActive       Boolean  @default(true)
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  stocks         WarehouseStock[]
  assetUnits     AssetUnit[]
  purchases      EquipmentPurchase[]
  issues         EquipmentIssue[]

  @@unique([organizationId, code])
  @@map("warehouses")
}

// Running stock balance per item+warehouse, for BULK-tracked items only.
// SERIALIZED items derive on-hand count from AssetUnit rows instead —
// deliberately not duplicated here, to avoid a second counter that can drift.
model WarehouseStock {
  id             String    @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  itemId         String
  item           EquipmentItem @relation(fields: [itemId], references: [id])
  warehouseId    String
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id])
  quantityOnHand Int       @default(0)
  updatedAt      DateTime  @updatedAt

  @@unique([itemId, warehouseId])
  @@index([organizationId])
  @@map("warehouse_stocks")
}

// One row per physical serialized unit (a specific generator, vehicle,
// laptop, ...). Only created for EquipmentItem.trackingMode = SERIALIZED.
model AssetUnit {
  id                String          @id @default(cuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id])
  itemId            String
  item              EquipmentItem   @relation(fields: [itemId], references: [id])
  warehouseId       String
  warehouse         Warehouse       @relation(fields: [warehouseId], references: [id])
  assetTag          String
  serialNumber      String?
  status            AssetUnitStatus @default(IN_STOCK)
  currentEmployeeId String?
  currentEmployee   Employee?       @relation(fields: [currentEmployeeId], references: [id])
  currentProjectId  String?
  currentProject    Project?        @relation(fields: [currentProjectId], references: [id])
  purchaseCost      Decimal         @db.Decimal(10, 2)
  purchaseDate      DateTime        @db.Date
  nextMaintenanceAt DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  issues            EquipmentIssue[]
  maintenanceRecords MaintenanceRecord[]
  depreciationEntries DepreciationEntry[]

  @@unique([organizationId, assetTag])
  @@index([organizationId])
  @@map("asset_units")
}

enum AssetUnitStatus {
  IN_STOCK
  ISSUED
  IN_MAINTENANCE
  LOST
  DAMAGED
  RETIRED
  DISPOSED
}

// Append-only service log. Exactly one of itemId (bulk, SKU-level) /
// assetUnitId (serialized, per-unit) is set — enforced in the route, same
// polymorphic-ish convention as CustomFieldValue's entityType/entityId.
model MaintenanceRecord {
  id             String      @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  itemId         String?
  item           EquipmentItem? @relation(fields: [itemId], references: [id])
  assetUnitId    String?
  assetUnit      AssetUnit?  @relation(fields: [assetUnitId], references: [id])
  performedAt    DateTime    @db.Date
  performedBy    String?
  description    String
  cost           Decimal?    @default(0) @db.Decimal(10, 2)
  vendorId       String?
  vendor         Supplier?   @relation(fields: [vendorId], references: [id])
  nextDueDate    DateTime?   @db.Date
  notes          String?
  createdAt      DateTime    @default(now())

  @@index([organizationId])
  @@map("maintenance_records")
}

// Serialized-assets-only. Bulk consumables are expensed, not depreciated —
// standard practice, and there's no single per-unit cost to depreciate for
// a bulk SKU.
model DepreciationEntry {
  id                     String   @id @default(cuid())
  organizationId         String
  organization           Organization @relation(fields: [organizationId], references: [id])
  assetUnitId            String
  assetUnit              AssetUnit @relation(fields: [assetUnitId], references: [id])
  periodMonth            Int
  periodYear             Int
  depreciationAmount     Decimal  @db.Decimal(10, 2)
  accumulatedDepreciation Decimal @db.Decimal(10, 2)
  bookValue              Decimal  @db.Decimal(10, 2)
  createdAt              DateTime @default(now())

  @@unique([assetUnitId, periodMonth, periodYear])
  @@index([organizationId])
  @@map("depreciation_entries")
}

model EquipmentPurchase {
  id           String        @id @default(cuid())
  organizationId String
  organization Organization  @relation(fields: [organizationId], references: [id])
  itemId       String
  item         EquipmentItem @relation(fields: [itemId], references: [id])
  warehouseId  String
  warehouse    Warehouse     @relation(fields: [warehouseId], references: [id])
  receiptCode  String?
  quantity     Int
  unitCost     Decimal       @db.Decimal(10, 2)
  totalCost    Decimal       @db.Decimal(10, 2)
  purchaseDate DateTime      @db.Date
  supplierName String?
  supplierId   String?
  supplier     Supplier?     @relation(fields: [supplierId], references: [id])
  invoiceRef   String?
  notes        String?
  createdAt    DateTime      @default(now())

  @@index([organizationId])
  @@map("equipment_purchases")
}

model EquipmentIssue {
  id             String                   @id @default(cuid())
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id])
  itemId         String
  item           EquipmentItem            @relation(fields: [itemId], references: [id])
  warehouseId    String
  warehouse      Warehouse                @relation(fields: [warehouseId], references: [id])
  assetUnitId    String?
  assetUnit      AssetUnit?               @relation(fields: [assetUnitId], references: [id])
  projectId      String
  project        Project                  @relation(fields: [projectId], references: [id])
  employeeId     String
  employee       Employee                 @relation(fields: [employeeId], references: [id])
  quantity       Int
  unitCost       Decimal                  @db.Decimal(10, 2)
  totalCost      Decimal                  @db.Decimal(10, 2)
  issuedAt       DateTime                 @default(now())
  returnedAt     DateTime?
  returnedQty    Int                      @default(0)
  type           InventoryTransactionType @default(ISSUE)
  condition      String?
  lostDamagedQty Int                      @default(0)
  lostDamagedCost Decimal                 @default(0) @db.Decimal(10, 2)
  notes          String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([organizationId])
  @@map("equipment_issues")
}

enum InventoryTransactionType {
  PURCHASE
  ISSUE
  RETURN
  LOSS
  DAMAGE
  ADJUSTMENT
}

// ============================================================
// MODULE 5: QUOTATION BUILDER
// ============================================================

model Quotation {
  id              String          @id @default(cuid())
  organizationId  String
  organization    Organization    @relation(fields: [organizationId], references: [id])
  quotationCode   String
  clientId        String
  client          Client          @relation(fields: [clientId], references: [id])
  projectId       String?         @unique
  project         Project?        @relation(fields: [projectId], references: [id])
  title           String
  description     String?
  validUntil      DateTime
  currencyCode    String          @default("SGD")
  subtotal        Decimal         @default(0) @db.Decimal(12, 2)
  discountAmount  Decimal         @default(0) @db.Decimal(12, 2)
  taxRate         Decimal         @default(0.09) @db.Decimal(5, 4)
  taxAmount       Decimal         @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal         @default(0) @db.Decimal(12, 2)
  status          QuotationStatus @default(DRAFT)
  sentAt          DateTime?
  viewedAt        DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  notes           String?
  termsAndCond    String?
  pdfUrl          String?
  portalToken     String?         @unique
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  lineItems       QuotationLineItem[]

  @@unique([organizationId, quotationCode])
  @@map("quotations")
}

enum QuotationStatus {
  DRAFT
  SENT
  VIEWED
  APPROVED
  REJECTED
  EXPIRED
}

model QuotationLineItem {
  id            String    @id @default(cuid())
  organizationId String
  organization  Organization @relation(fields: [organizationId], references: [id])
  quotationId   String
  quotation     Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  description   String
  workerType    String?
  quantity      Decimal   @db.Decimal(10, 2)
  unit          String    @default("days")
  unitRate      Decimal   @db.Decimal(10, 2)
  currencyCode  String    @default("SGD")
  amount        Decimal   @db.Decimal(12, 2)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())

  @@index([organizationId])
  @@map("quotation_line_items")
}

// ============================================================
// MODULE 6: REVENUE & BILLING
// ============================================================

model Invoice {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id])
  invoiceCode     String
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id])
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id])
  issueDate       DateTime      @db.Date
  dueDate         DateTime      @db.Date
  currencyCode    String        @default("SGD")
  subtotal        Decimal       @default(0) @db.Decimal(12, 2)
  taxRate         Decimal       @default(0.09) @db.Decimal(5, 4)
  taxAmount       Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal       @default(0) @db.Decimal(12, 2)
  paidAmount      Decimal       @default(0) @db.Decimal(12, 2)
  outstandingAmount Decimal     @default(0) @db.Decimal(12, 2)
  status          InvoiceStatus @default(DRAFT)
  reminderCount   Int           @default(0)
  lastReminderAt  DateTime?
  notes           String?
  pdfUrl          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  lineItems       InvoiceLineItem[]
  payments        Payment[]

  @@unique([organizationId, invoiceCode])
  @@map("invoices")
}

enum InvoiceStatus {
  DRAFT
  SENT
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

model InvoiceLineItem {
  id          String   @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal  @db.Decimal(10, 2)
  unit        String   @default("days")
  unitRate    Decimal  @db.Decimal(10, 2)
  currencyCode String  @default("SGD")
  amount      Decimal  @db.Decimal(12, 2)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([organizationId])
  @@map("invoice_line_items")
}

model Payment {
  id            String   @id @default(cuid())
  organizationId String
  organization  Organization @relation(fields: [organizationId], references: [id])
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id])
  amount        Decimal  @db.Decimal(10, 2)
  currencyCode  String   @default("SGD")
  paymentDate   DateTime @db.Date
  paymentMethod String?
  reference     String?
  notes         String?
  createdAt     DateTime @default(now())

  @@index([organizationId])
  @@map("payments")
}

// ============================================================
// MODULE 9: WORK PASS & COMPLIANCE (MOM)
// ============================================================

model WorkPass {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  employeeId     String
  employee       Employee       @relation(fields: [employeeId], references: [id])
  passType       WorkPassType
  passNumber     String
  issuedBy       String         @default("MOM")
  issueDate      DateTime       @db.Date
  expiryDate     DateTime       @db.Date
  status         WorkPassStatus @default(ACTIVE)
  documentUrl    String?
  renewalHistory WorkPassRenewal[]
  cancelledAt    DateTime?
  cancelReason   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([organizationId, passNumber])
  @@map("work_passes")
}

enum WorkPassType {
  WORK_PERMIT
  S_PASS
  EMPLOYMENT_PASS
  TRAINING_WORK_PERMIT
  LETTER_OF_CONSENT
}

enum WorkPassStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  RENEWED
  CANCELLED
}

model WorkPassRenewal {
  id            String    @id @default(cuid())
  organizationId String
  organization  Organization @relation(fields: [organizationId], references: [id])
  workPassId    String
  workPass      WorkPass  @relation(fields: [workPassId], references: [id])
  oldPassNumber String
  oldExpiryDate DateTime
  newPassNumber String
  newExpiryDate DateTime
  renewedAt     DateTime  @default(now())
  documentUrl   String?
  notes         String?

  @@index([organizationId])
  @@map("work_pass_renewals")
}

// ============================================================
// MODULE 11: NOTIFICATIONS & REMINDERS
// ============================================================

model Notification {
  id          String               @id @default(cuid())
  organizationId String
  organization Organization        @relation(fields: [organizationId], references: [id])
  userId      String?
  user        User?                @relation(fields: [userId], references: [id])
  projectId   String?
  project     Project?             @relation(fields: [projectId], references: [id])
  type        NotificationType
  title       String
  message     String
  priority    NotificationPriority @default(MEDIUM)
  channel     NotificationChannel  @default(IN_APP)
  isRead      Boolean              @default(false)
  isResolved  Boolean              @default(false)
  resolvedAt  DateTime?
  resolvedNote String?
  metadata    Json?
  sentAt      DateTime?
  createdAt   DateTime             @default(now())

  @@index([organizationId])
  @@map("notifications")
}

enum NotificationType {
  WORK_PASS_EXPIRING_30
  WORK_PASS_EXPIRING_15
  WORK_PASS_EXPIRING_7
  WORK_PASS_EXPIRED
  WORK_PASS_RENEWED
  INVOICE_OVERDUE
  PROJECT_BUDGET_80
  PAYMENT_RECEIVED
  PROFIT_BELOW_TARGET
  PROJECT_END_APPROACHING
  EQUIPMENT_MAINTENANCE_DUE
  INVENTORY_LOW_STOCK
  PROJECT_COMPLETED
  EMPLOYEE_CERT_EXPIRING
  PAYROLL_REMINDER
  EMPLOYEE_SAFETY_TRAINING_DUE
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
  CRITICAL
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
}

model NotificationPreference {
  id          String              @id @default(cuid())
  organizationId String
  organization Organization       @relation(fields: [organizationId], references: [id])
  userId      String
  type        NotificationType
  inApp       Boolean             @default(true)
  email       Boolean             @default(true)
  whatsapp    Boolean             @default(false)
  daysBefore  Int?
  isEnabled   Boolean             @default(true)
  updatedAt   DateTime            @updatedAt

  @@unique([userId, type])
  @@index([organizationId])
  @@map("notification_preferences")
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id         String   @id @default(cuid())
  organizationId String?
  organization Organization? @relation(fields: [organizationId], references: [id])
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entity     String
  entityId   String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([organizationId])
  @@map("audit_logs")
}

// ============================================================
// PASSWORD RESET
// (deliberately NOT tenant-scoped — always looked up by unique
// token and joined through User, never listed by organization)
// ============================================================

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

// ============================================================
// MODULE 12: CALENDAR & HOLIDAYS
// ============================================================

model Holiday {
  id          String      @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  name        String
  date        DateTime    @db.Date
  type        HolidayType @default(PUBLIC_HOLIDAY)
  description String?
  isRecurring Boolean     @default(false)
  country     String      @default("SG")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([organizationId, date, name])
  @@map("holidays")
}

enum HolidayType {
  PUBLIC_HOLIDAY
  COMPANY_HOLIDAY
  HALF_DAY
  WORKING_SATURDAY
}

// ============================================================
// PHASE 1 — HR CORE
// ============================================================

// ---- Statutory contribution rule engine ----
// SG_CPF rows delegate to the existing lib/cpf.ts graduated-rate calculator
// unchanged; FLAT_RATE rows use employeeRate/employerRate/wageCeiling below.
// This is what replaces Employee.cpfApplicable's hardcoded flag.
model StatutoryScheme {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  code           String
  name           String
  strategy       StatutoryStrategy
  employeeRate   Decimal? @db.Decimal(5, 4)
  employerRate   Decimal? @db.Decimal(5, 4)
  wageCeiling    Decimal? @db.Decimal(10, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  employees      Employee[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("statutory_schemes")
}

enum StatutoryStrategy {
  SG_CPF
  FLAT_RATE
}

// ---- Recruitment ----
model JobRequisition {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  code           String
  title          String
  department     String?
  employmentType EmploymentType @default(FULL_TIME)
  headcount      Int      @default(1)
  status         RequisitionStatus @default(OPEN)
  description    String?
  requestedById  String?
  requestedBy    Employee? @relation("RequisitionRequester", fields: [requestedById], references: [id])
  openedAt       DateTime @default(now())
  closedAt       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  applications   Application[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("job_requisitions")
}

enum RequisitionStatus {
  OPEN
  ON_HOLD
  FILLED
  CANCELLED
}

model Candidate {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  fullName       String
  email          String?
  phone          String?
  resumeUrl      String?
  source         String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  applications   Application[]

  @@index([organizationId])
  @@map("candidates")
}

model Application {
  id              String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  requisitionId   String
  requisition     JobRequisition @relation(fields: [requisitionId], references: [id])
  candidateId     String
  candidate       Candidate @relation(fields: [candidateId], references: [id])
  stage           ApplicationStage @default(APPLIED)
  rejectionReason String?
  hiredEmployeeId String?  @unique
  hiredEmployee   Employee? @relation("ApplicationHire", fields: [hiredEmployeeId], references: [id])
  appliedAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([requisitionId, candidateId])
  @@index([organizationId])
  @@map("applications")
}

enum ApplicationStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

// ---- Onboarding / Offboarding — one shared model family, parameterized
// by `purpose`, rather than two parallel sets of tables. Instance tasks are
// snapshotted from the template at instantiation time so later template
// edits don't retroactively change an in-flight checklist. ----
enum ChecklistPurpose {
  ONBOARDING
  OFFBOARDING
}

model ChecklistTemplate {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  purpose        ChecklistPurpose
  name           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tasks          ChecklistTemplateTask[]
  instances      ChecklistInstance[]

  @@index([organizationId, purpose])
  @@map("checklist_templates")
}

model ChecklistTemplateTask {
  id             String   @id @default(cuid())
  templateId     String
  template       ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  sortOrder      Int      @default(0)
  dueOffsetDays  Int?
  assigneeRoleId String?
  assigneeRole   Role?    @relation(fields: [assigneeRoleId], references: [id])

  @@map("checklist_template_tasks")
}

model ChecklistInstance {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  templateId     String
  template       ChecklistTemplate @relation(fields: [templateId], references: [id])
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id])
  purpose        ChecklistPurpose
  status         ChecklistInstanceStatus @default(IN_PROGRESS)
  startDate      DateTime @db.Date
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tasks          ChecklistInstanceTask[]

  @@index([organizationId, purpose])
  @@map("checklist_instances")
}

enum ChecklistInstanceStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ChecklistInstanceTask {
  id             String   @id @default(cuid())
  instanceId     String
  instance       ChecklistInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  templateTaskId String?
  title          String
  description    String?
  dueDate        DateTime? @db.Date
  isDone         Boolean  @default(false)
  doneAt         DateTime?
  doneById       String?
  sortOrder      Int      @default(0)

  @@map("checklist_instance_tasks")
}

// ---- Skills & Competency ----
model SkillDefinition {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  category       String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  employeeSkills EmployeeSkill[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("skill_definitions")
}

model EmployeeSkill {
  id              String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id])
  skillId         String
  skill           SkillDefinition @relation(fields: [skillId], references: [id])
  proficiency     SkillProficiency @default(BEGINNER)
  yearsExperience Decimal? @db.Decimal(4, 1)
  certifiedAt     DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([employeeId, skillId])
  @@index([organizationId])
  @@map("employee_skills")
}

enum SkillProficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

// ---- Performance ----
model PerformanceReviewCycle {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  periodStart    DateTime @db.Date
  periodEnd      DateTime @db.Date
  status         ReviewCycleStatus @default(DRAFT)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  reviews        PerformanceReview[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("performance_review_cycles")
}

enum ReviewCycleStatus {
  DRAFT
  ACTIVE
  CLOSED
}

model PerformanceReview {
  id                String   @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  cycleId           String
  cycle             PerformanceReviewCycle @relation(fields: [cycleId], references: [id])
  employeeId        String
  employee          Employee @relation(fields: [employeeId], references: [id])
  reviewerId        String?
  reviewer          Employee? @relation("PerformanceReviewer", fields: [reviewerId], references: [id])
  selfAssessment    String?
  selfRating        Int?
  managerAssessment String?
  managerRating     Int?
  status            PerformanceReviewStatus @default(PENDING_SELF_ASSESSMENT)
  submittedAt       DateTime?
  completedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([cycleId, employeeId])
  @@index([organizationId])
  @@map("performance_reviews")
}

enum PerformanceReviewStatus {
  PENDING_SELF_ASSESSMENT
  PENDING_MANAGER_REVIEW
  COMPLETED
}

// ---- Employee Relations / Case Management ----
model EmployeeCase {
  id              String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  caseCode        String
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id])
  type            EmployeeCaseType
  category        String?
  title           String
  description     String?
  status          EmployeeCaseStatus @default(OPEN)
  priority        EmployeeCasePriority @default(MEDIUM)
  assignedToId    String?
  assignedTo      Employee? @relation("CaseAssignee", fields: [assignedToId], references: [id])
  confidential    Boolean  @default(true)
  resolvedAt      DateTime?
  resolutionNotes String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  comments        EmployeeCaseComment[]

  @@unique([organizationId, caseCode])
  @@index([organizationId])
  @@map("employee_cases")
}

enum EmployeeCaseType {
  GRIEVANCE
  DISCIPLINARY
  HELPDESK
}

enum EmployeeCaseStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum EmployeeCasePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model EmployeeCaseComment {
  id           String   @id @default(cuid())
  caseId       String
  case         EmployeeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorUserId String
  authorUser   User     @relation(fields: [authorUserId], references: [id])
  body         String
  isInternal   Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("employee_case_comments")
}

// ---- Payroll batching ----
model PayrollRun {
  id                 String   @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id])
  runCode            String
  projectId          String?
  project            Project? @relation(fields: [projectId], references: [id])
  month              Int
  year               Int
  status             PayrollRunStatus @default(COMPLETED)
  totalPayable       Decimal  @default(0) @db.Decimal(12, 2)
  totalCostToCompany Decimal  @default(0) @db.Decimal(12, 2)
  recordCount        Int      @default(0)
  runById            String?
  runAt              DateTime @default(now())
  paidAt             DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  records            PayrollRecord[]

  @@unique([organizationId, runCode])
  @@index([organizationId])
  @@map("payroll_runs")
}

enum PayrollRunStatus {
  COMPLETED
  PAID
}
