# Database
DATABASE_URL="postgresql://aadhirai:aadhirai_pass@localhost:5432/aadhirai"

# Auth
JWT_SECRET="change-this-to-a-long-random-secret-in-production"
JWT_ACCESS_EXPIRES_IN="15m"

# Field-level PII encryption (Employee.nricOrFin, bankAccountNo, SSO client secrets).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="change-this-to-a-32-byte-hex-key-in-production"

# App
PORT=4000
NODE_ENV=development

# Frontend
FRONTEND_URL="http://localhost:3000"
